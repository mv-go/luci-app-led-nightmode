#!/bin/sh /etc/rc.common

START=95
STOP=10
USE_PROCD=1

PROG=/usr/libexec/led-nightmode-service

validate_core_section() {
	uci_validate_section led-nightmode core "$1" \
		'enabled:bool:0' \
		'phase:or("day", "night"):day' \
		'night_brightness:uinteger:1'
}

start_service() {
	local section=main
	local enabled phase night_brightness

	validate_core_section "$section" || {
		echo "led-nightmode: invalid UCI section '$section'" >&2
		return 1
	}
	[ "$enabled" -eq 1 ] || return 0

	procd_open_instance "$section"
	procd_set_param command "$PROG" "$phase" "$night_brightness"
	procd_set_param file /etc/config/led-nightmode
	procd_set_param stdout 1
	procd_set_param stderr 1
	procd_close_instance
}

service_triggers() {
	procd_add_reload_trigger led-nightmode
	procd_add_validation validate_core_section
}
