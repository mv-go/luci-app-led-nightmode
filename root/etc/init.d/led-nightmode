#!/bin/sh /etc/rc.common

START=95
STOP=10
USE_PROCD=1

PROG=/usr/libexec/led-nightmode-service
PROVIDER_PROG=/usr/libexec/led-nightmode-provider-service

validate_core_section() {
	uci_validate_section led-nightmode core "$1" \
		'enabled:bool:0' \
		'phase:or("day", "night"):day' \
		'night_brightness:uinteger:0'
}

validate_provider_section() {
	uci_validate_section led-nightmode provider "$1" \
		'enabled:bool:0' \
		'driver:string' \
		'device:string'
}

PROVIDER_CONFIG_VALID=1

validate_provider_entry() {
	local section=$1
	local enabled driver device

	validate_provider_section "$section" || {
		PROVIDER_CONFIG_VALID=0
		return
	}
	[ "$enabled" -eq 1 ] || return
	case $section in
		''|*[!a-zA-Z0-9_-]*)
			echo "led-nightmode: provider sections must have a safe explicit name" >&2
			PROVIDER_CONFIG_VALID=0
			return
			;;
	esac
	if [ -z "$driver" ] || [ -z "$device" ]; then
		echo "led-nightmode: provider '$section' requires driver and device" >&2
		PROVIDER_CONFIG_VALID=0
	fi
}

start_provider_instance() {
	local section=$1
	local phase=$2
	local enabled driver device

	validate_provider_section "$section" || return 1
	[ "$enabled" -eq 1 ] || return 0

	procd_open_instance "provider-$section"
	procd_set_param command "$PROVIDER_PROG" "$driver" "$device" "$section" "$phase"
	procd_set_param file /etc/config/led-nightmode
	procd_set_param stdout 1
	procd_set_param stderr 1
	procd_close_instance
}

start_service() {
	local section=main
	local enabled phase night_brightness
	local core_enabled core_phase core_night_brightness

	config_load led-nightmode

	validate_core_section "$section" || {
		echo "led-nightmode: invalid UCI section '$section'" >&2
		return 1
	}
	core_enabled=$enabled
	core_phase=$phase
	core_night_brightness=$night_brightness
	[ "$core_enabled" -eq 1 ] || return 0

	PROVIDER_CONFIG_VALID=1
	config_foreach validate_provider_entry provider
	[ "$PROVIDER_CONFIG_VALID" -eq 1 ] || return 1

	procd_open_instance "$section"
	procd_set_param command "$PROG" "$core_phase" "$core_night_brightness"
	procd_set_param file /etc/config/led-nightmode
	procd_set_param stdout 1
	procd_set_param stderr 1
	procd_close_instance

	config_foreach start_provider_instance provider "$core_phase"
}

service_triggers() {
	procd_add_reload_trigger led-nightmode
	procd_add_validation validate_core_section validate_provider_section
}
