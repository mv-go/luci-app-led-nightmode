#!/bin/sh

set -u

PROGRAM=${0##*/}
CLI=${LED_NIGHTMODE_BIN:-/usr/sbin/led-nightmode}
PHASE=${1:-}
NIGHT_BRIGHTNESS=${2:-}
RESTORE_ON_EXIT=0

error() {
	printf '%s: %s\n' "$PROGRAM" "$*" >&2
}

is_uint() {
	case $1 in
		''|*[!0-9]*) return 1 ;;
		*) return 0 ;;
	esac
}

cleanup() {
	exit_status=$?
	trap - EXIT HUP INT TERM
	if [ "$RESTORE_ON_EXIT" -eq 1 ]; then
		if ! "$CLI" day; then
			error 'could not restore the day profile while stopping'
			exit_status=1
		fi
	fi
	exit "$exit_status"
}

if [ ! -x "$CLI" ]; then
	error "CLI is not executable: $CLI"
	exit 1
fi
case $PHASE in
	day|night) ;;
	*)
		error "phase must be 'day' or 'night'"
		exit 2
		;;
esac
if ! is_uint "$NIGHT_BRIGHTNESS"; then
	error 'night brightness must be a non-negative integer'
	exit 2
fi

trap cleanup EXIT
trap 'exit 0' HUP INT TERM

case $PHASE in
	night)
		RESTORE_ON_EXIT=1
		if ! LED_NIGHT_BRIGHTNESS=$NIGHT_BRIGHTNESS "$CLI" night; then
			exit 1
		fi
		;;
	day)
		if ! "$CLI" day; then
			exit 1
		fi
		;;
esac

while :; do
	sleep 3600 &
	wait $!
done
