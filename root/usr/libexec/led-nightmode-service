#!/bin/sh

set -u

PROGRAM=${0##*/}
SUNWAIT=${LED_SUNWAIT_BIN:-/usr/bin/sunwait}

error() {
	printf '%s: %s\n' "$PROGRAM" "$*" >&2
}

valid_phase() {
	case $1 in
		day|night) return 0 ;;
		*) return 1 ;;
	esac
}

valid_time() {
	case $1 in
		[01][0-9]:[0-5][0-9]|2[0-3]:[0-5][0-9]) return 0 ;;
		*) return 1 ;;
	esac
}

valid_coordinate() {
	coordinate=$1
	maximum=$2
	awk -v coordinate="$coordinate" -v maximum="$maximum" 'BEGIN {
		if (coordinate !~ /^-?[0-9]+([.][0-9]+)?$/)
			exit 1
		if ((coordinate + 0) < -maximum || (coordinate + 0) > maximum)
			exit 1
		exit 0
	}'
}

format_coordinate() {
	coordinate=$1
	positive_suffix=$2
	negative_suffix=$3
	case $coordinate in
		-*) printf '%s%s\n' "${coordinate#-}" "$negative_suffix" ;;
		*) printf '%s%s\n' "$coordinate" "$positive_suffix" ;;
	esac
}

validate_schedule() {
	valid_phase "$MANUAL_PHASE" || {
		error "manual phase must be 'day' or 'night'"
		return 1
	}

	case $MODE in
		manual)
			return 0
			;;
		fixed)
			valid_time "$NIGHT_START" || {
				error 'night_start must use HH:MM in local time'
				return 1
			}
			valid_time "$DAY_START" || {
				error 'day_start must use HH:MM in local time'
				return 1
			}
			[ "$NIGHT_START" != "$DAY_START" ] || {
				error 'night_start and day_start must differ'
				return 1
			}
			;;
		sun)
			valid_coordinate "$LATITUDE" 90 || {
				error 'latitude must be a decimal number from -90 to 90'
				return 1
			}
			valid_coordinate "$LONGITUDE" 180 || {
				error 'longitude must be a decimal number from -180 to 180'
				return 1
			}
			case $TWILIGHT in
				daylight|civil|nautical|astronomical) ;;
				*)
					error 'twilight must be daylight, civil, nautical, or astronomical'
					return 1
					;;
			esac
			[ -x "$SUNWAIT" ] || {
				error "sunwait is not executable: $SUNWAIT"
				return 1
			}
			;;
		*)
			error 'mode must be manual, fixed, or sun'
			return 1
			;;
	esac
}

resolve_fixed() {
	now=${LED_NIGHTMODE_NOW:-$(date +%H:%M)}
	valid_time "$now" || {
		error "current local time is invalid: $now"
		return 1
	}

	now_number=1$(printf '%s' "$now" | tr -d ':')
	night_number=1$(printf '%s' "$NIGHT_START" | tr -d ':')
	day_number=1$(printf '%s' "$DAY_START" | tr -d ':')

	if [ "$night_number" -lt "$day_number" ]; then
		if [ "$now_number" -ge "$night_number" ] && [ "$now_number" -lt "$day_number" ]; then
			printf '%s\n' night
		else
			printf '%s\n' day
		fi
	elif [ "$now_number" -ge "$night_number" ] || [ "$now_number" -lt "$day_number" ]; then
		printf '%s\n' night
	else
		printf '%s\n' day
	fi
}

resolve_sun() {
	formatted_latitude=$(format_coordinate "$LATITUDE" N S) || return 1
	formatted_longitude=$(format_coordinate "$LONGITUDE" E W) || return 1
	sunwait_status=0
	"$SUNWAIT" poll "$TWILIGHT" "$formatted_latitude" "$formatted_longitude" \
		>/dev/null 2>&1 || sunwait_status=$?
	case $sunwait_status in
		2) printf '%s\n' day ;;
		3) printf '%s\n' night ;;
		*)
			error "sunwait poll failed with status $sunwait_status"
			return 1
			;;
	esac
}

schedule_main() {
	command=$1
	MODE=${2:-}
	MANUAL_PHASE=${3:-}
	NIGHT_START=${4:-}
	DAY_START=${5:-}
	LATITUDE=${6:-}
	LONGITUDE=${7:-}
	TWILIGHT=${8:-}

	validate_schedule || return 1
	[ "$command" = resolve ] || return 0
	case $MODE in
		manual) printf '%s\n' "$MANUAL_PHASE" ;;
		fixed) resolve_fixed ;;
		sun) resolve_sun ;;
	esac
}

rpc_load_json() {
	json_library=${IPKG_INSTROOT:-}/usr/share/libubox/jshn.sh
	[ -r "$json_library" ] || {
		error "JSON helper is unavailable: $json_library"
		return 1
	}
	. "$json_library"
}

rpc_uci_get() {
	uci_key=$1
	default_value=$2
	uci_value=$("$RPC_UCI" -q get "$uci_key" 2>/dev/null) || uci_value=$default_value
	printf '%s\n' "$uci_value"
}

rpc_read_config() {
	RPC_ENABLED=$(rpc_uci_get led-nightmode.main.enabled 0)
	RPC_MANUAL_PHASE=$(rpc_uci_get led-nightmode.main.phase day)
	RPC_MODE=$(rpc_uci_get led-nightmode.schedule.mode manual)
	RPC_NIGHT_START=$(rpc_uci_get led-nightmode.schedule.night_start 23:00)
	RPC_DAY_START=$(rpc_uci_get led-nightmode.schedule.day_start 07:00)
	RPC_LATITUDE=$(rpc_uci_get led-nightmode.schedule.latitude '')
	RPC_LONGITUDE=$(rpc_uci_get led-nightmode.schedule.longitude '')
	RPC_TWILIGHT=$(rpc_uci_get led-nightmode.schedule.twilight daylight)
	RPC_ROUTER_ZONENAME=$(rpc_uci_get 'system.@system[0].zonename' '')
}

rpc_resolve_phase() {
	"$RPC_SCHEDULE" resolve "$RPC_MODE" "$RPC_MANUAL_PHASE" \
		"$RPC_NIGHT_START" "$RPC_DAY_START" "$RPC_LATITUDE" \
		"$RPC_LONGITUDE" "$RPC_TWILIGHT"
}

rpc_result() {
	result_value=$1
	result_message=${2:-}
	json_init
	json_add_boolean success "$result_value"
	[ -z "$result_message" ] || json_add_string message "$result_message"
	json_dump
	json_cleanup
}

rpc_status() {
	rpc_read_config
	if "$RPC_INIT" running >/dev/null 2>&1; then
		running=1
	else
		running=0
	fi
	case $RPC_ENABLED in
		1|true|yes|on) enabled=1 ;;
		*) enabled=0 ;;
	esac
	effective_phase=unknown
	if [ -r "$RPC_PHASE_FILE" ]; then
		phase_value=$(cat "$RPC_PHASE_FILE" 2>/dev/null) || phase_value=
		valid_phase "$phase_value" && effective_phase=$phase_value
	fi
	desired_phase=unknown
	schedule_valid=0
	if resolved_phase=$(rpc_resolve_phase 2>/dev/null); then
		if valid_phase "$resolved_phase"; then
			desired_phase=$resolved_phase
			schedule_valid=1
		fi
	fi

	json_init
	json_add_boolean enabled "$enabled"
	json_add_boolean running "$running"
	json_add_boolean schedule_valid "$schedule_valid"
	json_add_string mode "$RPC_MODE"
	json_add_string manual_phase "$RPC_MANUAL_PHASE"
	json_add_string effective_phase "$effective_phase"
	json_add_string desired_phase "$desired_phase"
	json_add_string router_zonename "$RPC_ROUTER_ZONENAME"
	json_dump
	json_cleanup
}

rpc_leds() {
	if ! led_listing=$("$RPC_CLI" list 2>/dev/null); then
		rpc_result 0 'could not read LED capabilities'
		return 1
	fi

	json_init
	json_add_boolean success 1
	json_add_array leds
	line_number=0
	tab=$(printf '\t')
	while IFS="$tab" read -r led_name max_brightness brightness active_trigger brightness_model timer_parameters; do
		line_number=$((line_number + 1))
		[ "$line_number" -gt 1 ] || continue
		[ -n "$led_name" ] || continue
		json_add_object ''
		json_add_string name "$led_name"
		json_add_string max_brightness "$max_brightness"
		json_add_string brightness "$brightness"
		json_add_string active_trigger "$active_trigger"
		json_add_string brightness_model "$brightness_model"
		json_close_object
	done <<-EOF
	$led_listing
	EOF
	json_close_array
	json_dump
	json_cleanup
}

rpc_resolve() {
	rpc_read_config
	if resolved_phase=$(rpc_resolve_phase 2>/dev/null) && valid_phase "$resolved_phase"; then
		json_init
		json_add_boolean success 1
		json_add_string phase "$resolved_phase"
		json_dump
		json_cleanup
	else
		rpc_result 0 'schedule configuration is invalid or unavailable'
		return 1
	fi
}

rpc_reload() {
	if "$RPC_INIT" reload >/dev/null 2>&1; then
		rpc_result 1
	else
		rpc_result 0 'service reload failed'
		return 1
	fi
}

rpc_set_manual() {
	manual_target=$1
	valid_phase "$manual_target" || {
		rpc_result 0 "phase must be 'day' or 'night'"
		return 1
	}
	if ! "$RPC_UCI" -q batch >/dev/null <<-EOF
		set led-nightmode.schedule.mode='manual'
		set led-nightmode.main.phase='$manual_target'
		commit led-nightmode
	EOF
	then
		rpc_result 0 'could not save manual phase'
		return 1
	fi
	rpc_reload
}

rpc_valid_identifier() {
	case $1 in
		''|*[!a-zA-Z0-9_-]*) return 1 ;;
		*) return 0 ;;
	esac
}

rpc_probe() {
	probe_driver=$1
	probe_device=$2
	probe_instance=${3:-probe}
	rpc_valid_identifier "$probe_driver" || {
		rpc_result 0 'invalid provider driver'
		return 1
	}
	rpc_valid_identifier "$probe_instance" || {
		rpc_result 0 'invalid provider instance'
		return 1
	}
	[ -n "$probe_device" ] || {
		rpc_result 0 'provider device is required'
		return 1
	}
	provider_bin=$RPC_PROVIDER_DIR/$probe_driver
	[ -x "$provider_bin" ] || {
		rpc_result 0 'provider driver is unavailable'
		return 1
	}
	if probe_output=$(LED_PROVIDER_DEVICE="$probe_device" \
		LED_PROVIDER_INSTANCE="$probe_instance" \
		LED_PROVIDER_STATE_DIR="$RPC_RUNTIME_DIR/probe/$probe_instance" \
		"$provider_bin" probe 2>&1); then
		json_init
		json_add_boolean success 1
		json_add_string output "$probe_output"
		json_dump
		json_cleanup
	else
		rpc_result 0 "$probe_output"
		return 1
	fi
}

rpc_test_provider() {
	test_driver=$1
	test_device=$2
	test_instance=${3:-test}
	rpc_valid_identifier "$test_driver" || {
		rpc_result 0 'invalid provider driver'
		return 1
	}
	rpc_valid_identifier "$test_instance" || {
		rpc_result 0 'invalid provider instance'
		return 1
	}
	[ -n "$test_device" ] || {
		rpc_result 0 'provider device is required'
		return 1
	}
	provider_bin=$RPC_PROVIDER_DIR/$test_driver
	[ -x "$provider_bin" ] || {
		rpc_result 0 'provider driver is unavailable'
		return 1
	}
	if test_output=$(LED_PROVIDER_DEVICE="$test_device" \
		LED_PROVIDER_INSTANCE="$test_instance" \
		LED_PROVIDER_STATE_DIR="$RPC_PROVIDER_STATE_ROOT/$test_instance" \
		"$provider_bin" test 2>&1); then
		json_init
		json_add_boolean success 1
		json_add_string output "$test_output"
		json_dump
		json_cleanup
	else
		rpc_result 0 "$test_output"
		return 1
	fi
}

rpc_drivers() {
	json_init
	json_add_array drivers
	for provider_bin in "$RPC_PROVIDER_DIR"/*; do
		[ -x "$provider_bin" ] || continue
		provider_name=${provider_bin##*/}
		rpc_valid_identifier "$provider_name" || continue
		json_add_string '' "$provider_name"
	done
	json_close_array
	json_dump
	json_cleanup
}

rpc_list() {
	json_init
	json_add_object status
	json_close_object
	json_add_object leds
	json_close_object
	json_add_object resolve
	json_close_object
	json_add_object drivers
	json_close_object
	json_add_object probe
	json_add_string driver driver
	json_add_string device device
	json_add_string instance instance
	json_close_object
	json_add_object test
	json_add_string driver driver
	json_add_string device device
	json_add_string instance instance
	json_close_object
	json_add_object set_manual
	json_add_string phase phase
	json_close_object
	json_add_object reload
	json_close_object
	json_dump
	json_cleanup
}

rpc_read_input() {
	rpc_input=
	IFS= read -r rpc_input || [ -n "$rpc_input" ] || rpc_input='{}'
	json_load "$rpc_input"
}

rpc_call() {
	method=${1:-}
	case $method in
		status) rpc_status ;;
		leds) rpc_leds ;;
		resolve) rpc_resolve ;;
		drivers) rpc_drivers ;;
		reload) rpc_reload ;;
		set_manual)
			requested_phase=
			rpc_read_input || {
				rpc_result 0 'invalid request'
				return 1
			}
			json_get_var requested_phase phase
			json_cleanup
			rpc_set_manual "$requested_phase"
			;;
		probe)
			requested_driver=
			requested_device=
			requested_instance=
			rpc_read_input || {
				rpc_result 0 'invalid request'
				return 1
			}
			json_get_var requested_driver driver
			json_get_var requested_device device
			json_get_var requested_instance instance
			json_cleanup
			rpc_probe "$requested_driver" "$requested_device" "$requested_instance"
			;;
		test)
			requested_driver=
			requested_device=
			requested_instance=
			rpc_read_input || {
				rpc_result 0 'invalid request'
				return 1
			}
			json_get_var requested_driver driver
			json_get_var requested_device device
			json_get_var requested_instance instance
			json_cleanup
			rpc_test_provider "$requested_driver" "$requested_device" "$requested_instance"
			;;
		*)
			rpc_result 0 'unknown method'
			return 1
			;;
	esac
}

rpc_main() {
	set +u
	RPC_UCI=${LED_RPCD_UCI_BIN:-/sbin/uci}
	RPC_INIT=${LED_RPCD_INIT_BIN:-/etc/init.d/led-nightmode}
	RPC_SCHEDULE=${LED_RPCD_SCHEDULE_BIN:-/usr/libexec/led-nightmode-schedule}
	RPC_PHASE_FILE=${LED_RPCD_PHASE_FILE:-/var/run/led-nightmode/phase}
	RPC_RUNTIME_DIR=${LED_RPCD_RUNTIME_DIR:-/var/run/led-nightmode}
	RPC_PROVIDER_DIR=${LED_RPCD_PROVIDER_DIR:-/usr/libexec/led-nightmode/providers}
	RPC_PROVIDER_STATE_ROOT=${LED_RPCD_PROVIDER_STATE_ROOT:-/etc/led-nightmode/state/providers}
	RPC_CLI=${LED_RPCD_CLI_BIN:-/usr/sbin/led-nightmode}
	rpc_load_json || return 1
	case $1 in
		list) rpc_list ;;
		call) rpc_call "${2:-}" ;;
		*) return 1 ;;
	esac
}

case ${1:-} in
	validate|resolve)
		schedule_main "$@"
		exit $?
		;;
	list|call)
		rpc_main "$@"
		exit $?
		;;
esac

CLI=${LED_NIGHTMODE_BIN:-/usr/sbin/led-nightmode}
SCHEDULE=${LED_NIGHTMODE_SCHEDULE_BIN:-/usr/libexec/led-nightmode-schedule}
MANUAL_PHASE=${1:-}
NIGHT_BRIGHTNESS=${2:-}
MODE=${3:-manual}
NIGHT_START=${4:-23:00}
DAY_START=${5:-07:00}
LATITUDE=${6:-}
LONGITUDE=${7:-}
TWILIGHT=${8:-daylight}
RUNTIME_DIR=${LED_NIGHTMODE_RUNTIME_DIR:-/var/run/led-nightmode}
PHASE_FILE=$RUNTIME_DIR/phase
RESTORE_ON_EXIT=0
CURRENT_PHASE=

umask 077

write_runtime_phase() {
	mkdir -p "$RUNTIME_DIR" || return 1
	temporary_phase=$RUNTIME_DIR/.phase.tmp.$$
	printf '%s\n' "$1" > "$temporary_phase" || return 1
	mv "$temporary_phase" "$PHASE_FILE"
}

resolve_phase() {
	"$SCHEDULE" resolve "$MODE" "$MANUAL_PHASE" "$NIGHT_START" "$DAY_START" \
		"$LATITUDE" "$LONGITUDE" "$TWILIGHT"
}

apply_phase() {
	target_phase=$1
	[ "$target_phase" != "$CURRENT_PHASE" ] || return 0
	case $target_phase in
		night)
			RESTORE_ON_EXIT=1
			LED_NIGHT_BRIGHTNESS=$NIGHT_BRIGHTNESS "$CLI" night || return 1
			;;
		day)
			"$CLI" day || return 1
			RESTORE_ON_EXIT=0
			;;
		*) return 1 ;;
	esac
	CURRENT_PHASE=$target_phase
	write_runtime_phase "$CURRENT_PHASE" || error 'could not publish the current runtime phase'
}

is_uint() {
	case $1 in
		''|*[!0-9]*) return 1 ;;
		*) return 0 ;;
	esac
}

cleanup() {
	exit_status=$?
	trap - EXIT HUP INT TERM
	if [ "$RESTORE_ON_EXIT" -eq 1 ]; then
		if ! "$CLI" day; then
			error 'could not restore the day profile while stopping'
			exit_status=1
		fi
	fi
	rm -f "$PHASE_FILE" 2>/dev/null || true
	rmdir "$RUNTIME_DIR" 2>/dev/null || true
	exit "$exit_status"
}

if [ ! -x "$CLI" ]; then
	error "CLI is not executable: $CLI"
	exit 1
fi
case $MANUAL_PHASE in
	day|night) ;;
	*)
		error "phase must be 'day' or 'night'"
		exit 2
		;;
esac
if ! is_uint "$NIGHT_BRIGHTNESS"; then
	error 'night brightness must be a non-negative integer'
	exit 2
fi
[ -x "$SCHEDULE" ] || {
	error "schedule resolver is not executable: $SCHEDULE"
	exit 1
}
if ! "$SCHEDULE" validate "$MODE" "$MANUAL_PHASE" "$NIGHT_START" "$DAY_START" \
	"$LATITUDE" "$LONGITUDE" "$TWILIGHT"; then
	exit 2
fi

trap cleanup EXIT
trap 'exit 0' HUP INT TERM

initial_phase=$(resolve_phase) || exit 1
apply_phase "$initial_phase" || exit 1

while :; do
	case $MODE in
		manual) interval=${LED_SCHEDULE_INTERVAL:-3600} ;;
		fixed) interval=${LED_SCHEDULE_INTERVAL:-15} ;;
		sun) interval=${LED_SCHEDULE_INTERVAL:-60} ;;
	esac
	sleep "$interval" &
	wait $!
	desired_phase=$(resolve_phase) || {
		error 'could not resolve scheduled phase; keeping the current profile'
		continue
	}
	apply_phase "$desired_phase" || error "could not apply scheduled $desired_phase profile"
done
