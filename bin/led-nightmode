#!/bin/sh

set -u

PROGRAM=${0##*/}
SYSFS_ROOT=${LED_SYSFS_ROOT:-/sys/class/leds}
STATE_DIR=${LED_STATE_DIR:-/var/run/led-nightmode}
NIGHT_BRIGHTNESS=${LED_NIGHT_BRIGHTNESS:-1}
SYSFS_EMULATE=${LED_SYSFS_EMULATE:-0}
DRY_RUN=0
COMMAND=

umask 077

usage() {
	cat <<EOF
Usage: $PROGRAM [--dry-run] <command>

Commands:
  list       List discovered LEDs and their capabilities
  status     Show whether night mode is active and current LED state
  night      Save current state and apply the night profile
  day        Restore state saved by the night command

Options:
  -n, --dry-run  Report night/day changes without writing them
  -h, --help     Show this help

Environment:
  LED_SYSFS_ROOT        LED sysfs root (default: /sys/class/leds)
  LED_STATE_DIR         Saved state directory (default: /var/run/led-nightmode)
  LED_NIGHT_BRIGHTNESS  Brightness for dimmable LEDs (default: 1)
EOF
}

error() {
	printf '%s: %s\n' "$PROGRAM" "$*" >&2
}

is_uint() {
	case $1 in
		''|*[!0-9]*) return 1 ;;
		*) return 0 ;;
	esac
}

require_sysfs_root() {
	if [ ! -d "$SYSFS_ROOT" ]; then
		error "LED sysfs root does not exist: $SYSFS_ROOT"
		return 1
	fi
}

read_led_value() {
	value_file=$1
	if [ ! -r "$value_file" ]; then
		return 1
	fi
	IFS= read -r led_value < "$value_file" || [ -n "$led_value" ]
	printf '%s\n' "$led_value"
}

active_trigger() {
	trigger_file=$1
	if [ ! -r "$trigger_file" ]; then
		return 1
	fi

	trigger_line=$(read_led_value "$trigger_file") || return 1
	for trigger_token in $trigger_line; do
		case $trigger_token in
			\[*\])
				trigger_token=${trigger_token#\[}
				trigger_token=${trigger_token%\]}
				printf '%s\n' "$trigger_token"
				return 0
				;;
		esac
	done

	return 1
}

trigger_supported() {
	trigger_file=$1
	wanted_trigger=$2
	trigger_line=$(read_led_value "$trigger_file") || return 1

	for trigger_token in $trigger_line; do
		trigger_token=${trigger_token#\[}
		trigger_token=${trigger_token%\]}
		if [ "$trigger_token" = "$wanted_trigger" ]; then
			return 0
		fi
	done

	return 1
}

write_value() {
	value_file=$1
	new_value=$2

	if [ "$DRY_RUN" -eq 1 ]; then
		return 0
	fi

	if [ "$SYSFS_EMULATE" = 1 ] && [ "${value_file##*/}" = trigger ]; then
		trigger_line=$(read_led_value "$value_file") || return 1
		rendered_triggers=
		found_trigger=0

		for trigger_token in $trigger_line; do
			trigger_token=${trigger_token#\[}
			trigger_token=${trigger_token%\]}
			if [ "$trigger_token" = "$new_value" ]; then
				rendered_token="[$trigger_token]"
				found_trigger=1
			else
				rendered_token=$trigger_token
			fi
			if [ -n "$rendered_triggers" ]; then
				rendered_triggers="$rendered_triggers $rendered_token"
			else
				rendered_triggers=$rendered_token
			fi
		done

		[ "$found_trigger" -eq 1 ] || return 1
		printf '%s\n' "$rendered_triggers" > "$value_file"
		return $?
	fi

	printf '%s\n' "$new_value" > "$value_file"
}

write_trigger() {
	trigger_file=$1
	new_trigger=$2
	if ! trigger_supported "$trigger_file" "$new_trigger"; then
		return 1
	fi
	write_value "$trigger_file" "$new_trigger"
}

mode_allows_write() {
	attribute_file=$1
	attribute_listing=$(ls -ld "$attribute_file" 2>/dev/null) || return 1
	attribute_mode=${attribute_listing%% *}
	case $attribute_mode in
		??w*|?????w*|????????w*) return 0 ;;
		*) return 1 ;;
	esac
}

timer_capability() {
	led_dir=$1
	if [ -e "$led_dir/delay_on" ] && [ -e "$led_dir/delay_off" ]; then
		printf '%s\n' yes
	elif [ -e "$led_dir/delay_on" ] || [ -e "$led_dir/delay_off" ]; then
		printf '%s\n' partial
	else
		printf '%s\n' no
	fi
}

state_path_for() {
	led_name=$1
	printf '%s/%s\n' "$STATE_DIR" "$led_name"
}

remove_state_path() {
	state_path=$1
	attributes_path=$state_path/attributes

	if [ -d "$attributes_path" ]; then
		for saved_attribute in "$attributes_path"/*; do
			[ -f "$saved_attribute" ] || continue
			rm -f "$saved_attribute" || return 1
		done
		rmdir "$attributes_path" || return 1
	fi

	rm -f "$state_path/trigger" "$state_path/brightness" || return 1
	rmdir "$state_path"
}

save_trigger_attributes() {
	led_dir=$1
	attributes_path=$2
	saved_trigger=$3

	if [ "$saved_trigger" = none ]; then
		return 0
	fi
	mkdir -p "$attributes_path" || return 1

	for attribute_file in "$led_dir"/*; do
		[ -f "$attribute_file" ] || continue
		attribute_name=${attribute_file##*/}
		case $attribute_name in
			brightness|max_brightness|trigger|uevent) continue ;;
		esac
		[ -r "$attribute_file" ] && mode_allows_write "$attribute_file" || continue
		cat "$attribute_file" > "$attributes_path/$attribute_name" || return 1
	done
}

restore_trigger_attributes() {
	led_dir=$1
	state_path=$2
	attributes_path=$state_path/attributes

	[ -d "$attributes_path" ] || return 0
	for saved_attribute in "$attributes_path"/*; do
		[ -f "$saved_attribute" ] || continue
		attribute_name=${saved_attribute##*/}
		attribute_file=$led_dir/$attribute_name
		if [ ! -e "$attribute_file" ] || ! mode_allows_write "$attribute_file"; then
			error "${led_dir##*/}: trigger attribute '$attribute_name' is unavailable"
			return 1
		fi
		attribute_value=$(cat "$saved_attribute") || return 1
		if ! write_value "$attribute_file" "$attribute_value"; then
			error "${led_dir##*/}: could not restore trigger attribute '$attribute_name'"
			return 1
		fi
	done
}

save_state() {
	led_name=$1
	led_dir=$2
	saved_trigger=$3
	saved_brightness=$4
	state_path=$(state_path_for "$led_name")

	if [ -e "$state_path" ]; then
		return 0
	fi

	if ! mkdir -p "$STATE_DIR"; then
		error "cannot create state directory: $STATE_DIR"
		return 1
	fi

	temporary_state="$STATE_DIR/.${led_name}.tmp.$$"
	if ! mkdir "$temporary_state"; then
		return 1
	fi
	if ! printf '%s\n' "$saved_trigger" > "$temporary_state/trigger" ||
	   ! printf '%s\n' "$saved_brightness" > "$temporary_state/brightness" ||
	   ! save_trigger_attributes "$led_dir" "$temporary_state/attributes" "$saved_trigger"; then
		remove_state_path "$temporary_state" || true
		return 1
	fi

	if ! mv "$temporary_state" "$state_path"; then
		remove_state_path "$temporary_state" || true
		return 1
	fi
}

load_state() {
	state_path=$1
	SAVED_TRIGGER=$(read_led_value "$state_path/trigger") || return 1
	SAVED_BRIGHTNESS=$(read_led_value "$state_path/brightness") || return 1

	if [ -z "$SAVED_TRIGGER" ] || ! is_uint "$SAVED_BRIGHTNESS"; then
		return 1
	fi
}

has_saved_state() {
	[ -d "$STATE_DIR" ] || return 1
	for state_path in "$STATE_DIR"/*; do
		[ -d "$state_path" ] && [ -f "$state_path/trigger" ] && return 0
	done
	return 1
}

command_list() {
	require_sysfs_root || return 1
	printf 'name\tmax_brightness\tbrightness\tactive_trigger\tdimmable\ttimer_parameters\n'
	found_led=0
	result=0

	for led_dir in "$SYSFS_ROOT"/*; do
		[ -d "$led_dir" ] || continue
		found_led=1
		led_name=${led_dir##*/}
		max_brightness=$(read_led_value "$led_dir/max_brightness") || max_brightness='?'
		brightness=$(read_led_value "$led_dir/brightness") || brightness='?'
		trigger=$(active_trigger "$led_dir/trigger") || trigger='?'

		if is_uint "$max_brightness" && [ "$max_brightness" -gt 1 ]; then
			dimmable=yes
		elif is_uint "$max_brightness"; then
			dimmable=no
		else
			dimmable='?'
			result=1
		fi

		timer=$(timer_capability "$led_dir")
		printf '%s\t%s\t%s\t%s\t%s\t%s\n' \
			"$led_name" "$max_brightness" "$brightness" "$trigger" "$dimmable" "$timer"
	done

	if [ "$found_led" -eq 0 ]; then
		error "no LEDs found in $SYSFS_ROOT"
		return 1
	fi
	return "$result"
}

command_status() {
	require_sysfs_root || return 1
	if has_saved_state; then
		printf 'night_mode\tactive\n'
	else
		printf 'night_mode\tinactive\n'
	fi
	printf 'name\tbrightness\tactive_trigger\tmanaged\n'
	found_led=0
	result=0

	for led_dir in "$SYSFS_ROOT"/*; do
		[ -d "$led_dir" ] || continue
		found_led=1
		led_name=${led_dir##*/}
		brightness=$(read_led_value "$led_dir/brightness") || brightness='?'
		trigger=$(active_trigger "$led_dir/trigger") || trigger='?'
		state_path=$(state_path_for "$led_name")
		if [ -d "$state_path" ]; then
			managed=yes
		else
			managed=no
		fi
		[ "$brightness" != '?' ] && [ "$trigger" != '?' ] || result=1
		printf '%s\t%s\t%s\t%s\n' "$led_name" "$brightness" "$trigger" "$managed"
	done

	if [ "$found_led" -eq 0 ]; then
		error "no LEDs found in $SYSFS_ROOT"
		return 1
	fi
	return "$result"
}

night_target() {
	max_brightness=$1
	if [ "$max_brightness" -le 1 ]; then
		printf '%s\n' 0
	elif [ "$NIGHT_BRIGHTNESS" -gt "$max_brightness" ]; then
		printf '%s\n' "$max_brightness"
	else
		printf '%s\n' "$NIGHT_BRIGHTNESS"
	fi
}

command_night() {
	require_sysfs_root || return 1
	if ! is_uint "$NIGHT_BRIGHTNESS"; then
		error "LED_NIGHT_BRIGHTNESS must be a non-negative integer"
		return 1
	fi

	found_led=0
	result=0
	for led_dir in "$SYSFS_ROOT"/*; do
		[ -d "$led_dir" ] || continue
		found_led=1
		led_name=${led_dir##*/}
		max_brightness=$(read_led_value "$led_dir/max_brightness")
		brightness=$(read_led_value "$led_dir/brightness")
		trigger=$(active_trigger "$led_dir/trigger")

		if ! is_uint "$max_brightness" || ! is_uint "$brightness" || [ -z "$trigger" ]; then
			error "$led_name: incomplete or invalid LED state"
			result=1
			continue
		fi

		target=$(night_target "$max_brightness")
		if [ "$DRY_RUN" -eq 1 ]; then
			printf '%s: trigger %s -> none, brightness %s -> %s\n' \
				"$led_name" "$trigger" "$brightness" "$target"
			continue
		fi

		if ! save_state "$led_name" "$led_dir" "$trigger" "$brightness"; then
			error "$led_name: could not save original state"
			result=1
			continue
		fi

		if ! write_trigger "$led_dir/trigger" none; then
			error "$led_name: could not select the none trigger"
			result=1
			continue
		fi
		if ! write_value "$led_dir/brightness" "$target"; then
			error "$led_name: could not set brightness to $target"
			result=1
			continue
		fi
		printf '%s: night profile applied (brightness %s)\n' "$led_name" "$target"
	done

	if [ "$found_led" -eq 0 ]; then
		error "no LEDs found in $SYSFS_ROOT"
		return 1
	fi
	return "$result"
}

command_day() {
	if ! has_saved_state; then
		printf '%s\n' 'No saved LED state; nothing to restore.'
		return 0
	fi

	result=0
	for state_path in "$STATE_DIR"/*; do
		[ -d "$state_path" ] || continue
		led_name=${state_path##*/}
		led_dir=$SYSFS_ROOT/$led_name

		if ! load_state "$state_path"; then
			error "$led_name: saved state is invalid"
			result=1
			continue
		fi
		if [ ! -d "$led_dir" ]; then
			error "$led_name: LED is missing; saved state retained"
			result=1
			continue
		fi
		if ! trigger_supported "$led_dir/trigger" "$SAVED_TRIGGER"; then
			error "$led_name: saved trigger '$SAVED_TRIGGER' is unavailable"
			result=1
			continue
		fi

		if [ "$DRY_RUN" -eq 1 ]; then
			printf '%s: restore brightness %s and trigger %s\n' \
				"$led_name" "$SAVED_BRIGHTNESS" "$SAVED_TRIGGER"
			continue
		fi

		if ! write_trigger "$led_dir/trigger" none; then
			error "$led_name: could not select the none trigger before restore"
			result=1
			continue
		fi
		if ! write_value "$led_dir/brightness" "$SAVED_BRIGHTNESS"; then
			error "$led_name: could not restore brightness"
			result=1
			continue
		fi
		if [ "$SAVED_TRIGGER" != none ] && ! write_trigger "$led_dir/trigger" "$SAVED_TRIGGER"; then
			error "$led_name: could not restore trigger '$SAVED_TRIGGER'"
			result=1
			continue
		fi
		if ! restore_trigger_attributes "$led_dir" "$state_path"; then
			result=1
			continue
		fi

		if ! remove_state_path "$state_path"; then
			error "$led_name: restored state but could not remove saved state"
			result=1
			continue
		fi
		printf '%s: original state restored\n' "$led_name"
	done

	if [ "$DRY_RUN" -eq 0 ]; then
		rmdir "$STATE_DIR" 2>/dev/null || true
	fi
	return "$result"
}

while [ "$#" -gt 0 ]; do
	case $1 in
		-n|--dry-run)
			DRY_RUN=1
			;;
		-h|--help)
			usage
			exit 0
			;;
		list|status|night|day)
			if [ -n "$COMMAND" ]; then
				error "only one command may be specified"
				usage >&2
				exit 2
			fi
			COMMAND=$1
			;;
		*)
			error "unknown argument: $1"
			usage >&2
			exit 2
			;;
	esac
	shift
done

if [ -z "$COMMAND" ]; then
	usage >&2
	exit 2
fi

if [ "$DRY_RUN" -eq 1 ] && [ "$COMMAND" != night ] && [ "$COMMAND" != day ]; then
	error "--dry-run is valid only with night or day"
	exit 2
fi

case $COMMAND in
	list) command_list ;;
	status) command_status ;;
	night) command_night ;;
	day) command_day ;;
esac
